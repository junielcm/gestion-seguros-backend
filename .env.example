# ==============================================================================
# VARIABLES DE ENTORNO - Gestión de Seguros
# ==============================================================================
# Copia este archivo como .env y rellena tus valores:
#   cp .env.example .env
#
# NUNCA subas el archivo .env a un repositorio público.
#
# NOTA: Si no creas un archivo .env, el proyecto funciona con SQLite
#       automáticamente (sin configuración adicional).
# ==============================================================================

# --- Base de datos ---
# Por defecto usa SQLite. Para usar PostgreSQL, descomenta estas líneas:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=gestion_seguros_db
# DB_USER=postgres
# DB_PASSWORD=tu_password_aqui
# DB_HOST=localhost
# DB_PORT=5432

# --- Django ---
# Genera una clave secreta única para producción con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-cambia-esta-clave-en-produccion
DEBUG=True
